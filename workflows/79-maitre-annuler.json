      "webhookId": "aicare-aicare-annuler",
      "credentials": {
        "httpHeaderAuth": {
          "id": "aicarecle000000001",
          "name": "AI-Care clé des webhooks"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Annuler une tâche – contrôle de la demande : seul l'identifiant (UUID) de la tâche est lu.\nconst e = $input.first().json?.body ?? {};\nconst id = String(e.tache_id ?? '');\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)) throw new Error('tache_id invalide');\nreturn [{ json: { tache_id: id } }];\n"
      },
      "id": "a1c3e000-0243-4000-8000-000000000243",
      "name": "Contrôler la tâche",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH a AS (UPDATE soins.taches SET statut = 'annulee', termine_le = now() WHERE id = $1::uuid AND statut = 'en_cours' RETURNING id, type), j AS (INSERT INTO soins.journal_ia (evenement, action, details) SELECT 'tache_annulee', type, jsonb_build_object('tache_id', id) FROM a) SELECT (SELECT count(*) FROM a) > 0 AS annulee, coalesce((SELECT 'annulee' FROM a), (SELECT statut FROM soins.taches WHERE id = $1::uuid), 'inconnue') AS statut",
        "options": {
          "queryReplacement": "={{ [ $json.tache_id ] }}"
        }
      },
      "id": "a1c3e000-0244-4000-8000-000000000244",
      "name": "Annuler",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "aicarepg00000001",
          "name": "AI-Care Postgres"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Annuler une tâche – réponse à l'interface. L'annulation est prise en compte AVANT le prochain résident (ou la prochaine\n// étape) : la génération déjà en cours chez Ollama se termine, son résultat est abandonné.\nconst r = $input.first().json ?? {};\nreturn [{ json: { annulee: r.annulee === true, statut: r.statut ?? 'inconnue' } }];\n"
      },
      "id": "a1c3e000-0245-4000-8000-000000000245",
      "name": "Réponse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Contrôle de session – le jeton « Bearer » de l'en-tête Authorization (43 caractères URL-safe) est haché (SHA-256) : seul le haché est en base.\nconst entetes = $input.first().json?.headers ?? {};\nconst m = String(entetes.authorization ?? '').match(/^Bearer ([A-Za-z0-9_-]{43})$/);\nif (!m) return [{ json: { hash: '' } }];\nreturn [{ json: { hash: require('crypto').createHash('sha256').update(m[1]).digest('hex') } }];\n"
      },
      "id": "a1c3e000-0431-4000-8000-000000000431",
      "name": "Session (jeton)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        -380
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.identifiant, g.nom, s.jeton_hash FROM soins.sessions s JOIN soins.soignants g ON g.identifiant = s.identifiant WHERE s.jeton_hash = $1 AND s.expire_le > now() AND g.actif",
        "options": {
          "queryReplacement": "={{ [ $json.hash ] }}"
        }
      },
      "id": "a1c3e000-0432-4000-8000-000000000432",
      "name": "Session (base)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        -380
      ],
      "credentials": {
        "postgres": {
          "id": "aicarepg00000001",
          "name": "AI-Care Postgres"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Contrôle de session – résultat : un soignant identifié (session ouverte, non expirée, compte actif) ou rien.\nconst r = $input.first().json ?? {};\nif (!r.identifiant) return [{ json: { ok: false } }];\nreturn [{ json: { ok: true, soignant: { identifiant: r.identifiant, nom: r.nom }, jeton_hash: r.jeton_hash } }];\n"
      },
      "id": "a1c3e000-0433-4000-8000-000000000433",
      "name": "Session",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        -380
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Session valide ?",
              "leftValue": "={{ $json.ok === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1c3e000-0434-4000-8000-000000000434",
      "name": "Session valide ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        -380
      ]
    },
    {
      "parameters": {
        "jsCode": "// Contrôle de session – la session est valide : on rend aux nœuds suivants la requête d'origine (en-têtes, corps) telle que reçue.\nreturn [{ json: $('Webhook').first().json }];\n"
      },
      "id": "a1c3e000-0435-4000-8000-000000000435",
      "name": "Requête",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        -460
      ]
    },
    {
      "parameters": {
        "jsCode": "// Contrôle de session – refus : aucune donnée, seulement le motif. L'interface rouvre alors la page de connexion.\nreturn [{ json: { erreur: 'session' } }];\n"
      },
      "id": "a1c3e000-0436-4000-8000-000000000436",
      "name": "Refus (session)",
