{
  "id": "aicaremaitreann01",
  "name": "AI-Care – Annuler une tâche",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aicare-annuler",
        "responseMode": "lastNode",
        "options": {
          "allowedOrigins": "http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175"
        },
        "authentication": "headerAuth"
      },
      "id": "a1c3e000-0242-4000-8000-000000000242",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
