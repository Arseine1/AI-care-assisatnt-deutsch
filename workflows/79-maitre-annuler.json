      "parameters": {
        "jsCode": "// Aufgabe abbrechen – Prüfung der Anfrage: Nur die Kennung (UUID) der Aufgabe wird gelesen.\nconst e = $input.first().json?.body ?? {};\nconst id = String(e.tache_id ?? '');\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)) throw new Error('Ungültige tache_id');\nreturn [{ json: { tache_id: id } }];\n"
      },
      "id": "a1c3e000-0243-4000-8000-000000000243",
      "name": "Aufgabe prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH a AS (UPDATE soins.taches SET statut = 'annulee', termine_le = now() WHERE id = $1::uuid AND statut = 'en_cours' RETURNING id, type), j AS (INSERT INTO soins.journal_ia (evenement, action, details) SELECT 'tache_annulee', type, jsonb_build_object('tache_id', id) FROM a) SELECT (SELECT count(*) FROM a) > 0 AS annulee, coalesce((SELECT 'annulee' FROM a), (SELECT statut FROM soins.taches WHERE id = $1::uuid), 'inconnue') AS statut",
        "options": {
          "queryReplacement": "={{ [ $json.tache_id ] }}"
        }
      },
      "id": "a1c3e000-0244-4000-8000-000000000244",
      "name": "Abbrechen",
