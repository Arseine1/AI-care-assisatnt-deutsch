      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Aufgabe abbrechen – Antwort an die Oberfläche. Der Abbruch wird VOR dem nächsten Bewohner (oder dem nächsten\n// Schritt) berücksichtigt: Die bereits laufende Erstellung bei Ollama wird beendet, ihr Ergebnis wird verworfen.\nconst r = $input.first().json ?? {};\nreturn [{ json: { annulee: r.annulee === true, statut: r.statut ?? 'inconnue' } }];\n"
      },
      "id": "a1c3e000-0245-4000-8000-000000000245",
      "name": "Antwort",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Sitzungsprüfung – das « Bearer »-Token im Authorization-Header (43 URL-sichere Zeichen) wird gehasht (SHA-256): Nur der Hash steht in der Datenbank.\nconst entetes = $input.first().json?.headers ?? {};\nconst m = String(entetes.authorization ?? '').match(/^Bearer ([A-Za-z0-9_-]{43})$/);\nif (!m) return [{ json: { hash: '' } }];\nreturn [{ json: { hash: require('crypto').createHash('sha256').update(m[1]).digest('hex') } }];\n"
      },
      "id": "a1c3e000-0431-4000-8000-000000000431",
      "name": "Sitzung (Token)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        -380
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.identifiant, g.nom, s.jeton_hash FROM soins.sessions s JOIN soins.soignants g ON g.identifiant = s.identifiant WHERE s.jeton_hash = $1 AND s.expire_le > now() AND g.actif",
        "options": {
          "queryReplacement": "={{ [ $json.hash ] }}"
        }
      },
