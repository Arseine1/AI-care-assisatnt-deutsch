{
  "id": "aicarecourrierrat1",
  "name": "AI-Care – Nachholen der Post (alle 2 Minuten)",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */2 * * * *"
            }
          ]
        }
      },
      "id": "a1c3e000-0300-4000-8000-000000000300",
      "name": "Alle 2 Minuten",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        -100
      ]
    },
    {
      "parameters": {},
      "id": "a1c3e000-0301-4000-8000-000000000301",
      "name": "Manueller Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT message_id FROM soins.courriers_traites WHERE etat = 'traite' OR debut > now() - interval '15 minutes'",
        "options": {}
      },
      "id": "a1c3e000-0302-4000-8000-000000000302",
      "name": "Bereits verarbeitete Post",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        260,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "aicarepg00000001",
          "name": "AI-Care Postgres"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "url": "http://mailpit:8025/api/v1/messages?limit=50",
        "options": {
          "timeout": 60000
        }
      },
      "id": "a1c3e000-0303-4000-8000-000000000303",
      "name": "Aktuelle Nachrichten",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Nachholen der Post – Mailpit-Nachrichten mit Anhang, die vor mehr als einer Minute eingegangen sind (der Webhook kümmert sich\n// vielleicht darum) und weder verarbeitet noch bereits in Bearbeitung sind. Die Sperre (soins.courriers_traites, Status « en_cours » für 15 Minuten) verhindert jede doppelte Verarbeitung.\nconst traites = new Set($('Bereits verarbeitete Post').all().map((i) => i.json.message_id).filter(Boolean));\nconst messages = $input.first().json?.messages ?? [];\nreturn messages\n  .filter((m) => m.Attachments > 0 && !traites.has(m.ID) && Date.now() - new Date(m.Created).getTime() > 60000)\n  .map((m) => ({ json: { id: m.ID } }));\n"
      },
      "id": "a1c3e000-0304-4000-8000-000000000304",
      "name": "Nachzuholende Post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        0
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "aicarebrqcourrier1",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "a1c3e000-0305-4000-8000-000000000305",
      "name": "Post verarbeiten",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        980,
        0
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Alle 2 Minuten": {
      "main": [
        [
