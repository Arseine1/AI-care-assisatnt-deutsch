          "value": "aicarebrqapres01",
          "mode": "id"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "a1c3e000-0135-4000-8000-000000000135",
      "name": "Nach der Bestätigung",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1200,
        -120
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Bericht bestätigen – Antwort an die Oberfläche: die Bestätigung, dann was folgte (RAG, Übergabe).\n// Die Bestätigung bleibt gespeichert, auch wenn der nächste Schritt fehlschlägt: Der Fehler wird dann gemeldet, nicht verborgen.\nconst v = $('Speichern').first().json;\nconst a = $input.first().json ?? {};\nreturn [\n  {\n    json: {\n      ...v,\n      apres_validation: a.error ? { erreur: String(a.error.message ?? a.error).slice(0, 200) } : { rag: a.rag, transmission: a.transmission },\n    },\n  },\n];\n"
      },
      "id": "a1c3e000-0136-4000-8000-000000000136",
      "name": "Antwort Bestätigung",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        -120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Prüfung bestätigt?",
              "leftValue": "={{ $json.ok === true && $json.action === 'verifier_document' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1c3e000-0137-4000-8000-000000000137",
      "name": "Prüfung bestätigt?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "// Prüfbericht bestätigen – nur die Bestätigung eines Berichts « Dokument prüfen » kann das Schreiben in das RAG aufnehmen.\nreturn [{ json: { validation_id: $input.first().json.validation_id } }];\n"
      },
      "id": "a1c3e000-0138-4000-8000-000000000138",
      "name": "Zum bestätigten Schreiben",
