    {
      "parameters": {
        "jsCode": "// Valider un rapport – seule une validation de RAPPORT DE GARDE est ajoutée au RAG et transmise à l'équipe suivante.\nconst v = $input.first().json;\nreturn [{ json: { portee: 'resident', validation_ids: [v.validation_id] } }];\n"
      },
      "id": "a1c3e000-0134-4000-8000-000000000134",
      "name": "Vers après validation",
