      "parameters": {
        "jsCode": "// Bestätigen & Speichern – der gelesene Text und der Entwurf stammen aus der Anfrage; der Name der Pflegekraft stammt aus ihrer SITZUNG (Token), nie aus dem Body.\nconst b = $input.first().json?.body ?? {};\nconst s = $('Sitzung').first().json.soignant;\nreturn [{ json: { brouillon_id: b.brouillon_id, texte: b.texte, valide_par: s.nom, soignant_id: s.identifiant } }];\n"
      },
