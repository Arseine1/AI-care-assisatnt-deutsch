        "jsCode": "// Valider un rapport de vérification – réponse à l'interface : la validation, puis ce qu'est devenue la lettre.\nconst v = $('Enregistrer').first().json;\nconst a = $input.first().json ?? {};\nreturn [{ json: { ...v, apres_validation: a.error ? { erreur: String(a.error.message ?? a.error).slice(0, 200) } : { lettre: a.lettre } } }];\n"
      },
      "id": "a1c3e000-0140-4000-8000-000000000140",
