      "parameters": {
        "jsCode": "// Valider & Enregistrer – le texte relu et le brouillon viennent de la requête ; le nom du soignant vient de sa SESSION (jeton), jamais du corps.\nconst b = $input.first().json?.body ?? {};\nconst s = $('Session').first().json.soignant;\nreturn [{ json: { brouillon_id: b.brouillon_id, texte: b.texte, valide_par: s.nom, soignant_id: s.identifiant } }];\n"
      },
