      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Valider un rapport – réponse à l'interface : la validation, puis ce qui a suivi (RAG, transmission).\n// La validation reste enregistrée même si l'étape suivante échoue : l'erreur est alors signalée, pas cachée.\nconst v = $('Enregistrer').first().json;\nconst a = $input.first().json ?? {};\nreturn [\n  {\n    json: {\n      ...v,\n      apres_validation: a.error ? { erreur: String(a.error.message ?? a.error).slice(0, 200) } : { rag: a.rag, transmission: a.transmission },\n    },\n  },\n];\n"
      },
      "id": "a1c3e000-0136-4000-8000-000000000136",
      "name": "Réponse validation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        -120
      ]
    },
    {
