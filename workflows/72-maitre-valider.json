      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Prüfbericht bestätigen – Antwort an die Oberfläche: die Bestätigung, dann was aus dem Schreiben geworden ist.\nconst v = $('Speichern').first().json;\nconst a = $input.first().json ?? {};\nreturn [{ json: { ...v, apres_validation: a.error ? { erreur: String(a.error.message ?? a.error).slice(0, 200) } : { lettre: a.lettre } } }];\n"
      },
      "id": "a1c3e000-0140-4000-8000-000000000140",
      "name": "Antwort Bestätigung (Schreiben)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ]
    },
    {
