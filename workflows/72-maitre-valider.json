    {
      "parameters": {
        "jsCode": "// Bericht bestätigen – nur die Bestätigung eines DIENSTBERICHTS wird dem RAG hinzugefügt und an das nächste Team weitergegeben.\nconst v = $input.first().json;\nreturn [{ json: { portee: 'resident', validation_ids: [v.validation_id] } }];\n"
      },
      "id": "a1c3e000-0134-4000-8000-000000000134",
      "name": "Zur Nachbearbeitung",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -120
      ]
    },
    {
      "parameters": {
