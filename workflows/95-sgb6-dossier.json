        480,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "aicarepg00000001",
          "name": "AI-Care Postgres"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Rentenbeiträge – das zuletzt gespeicherte Ergebnis einer Akte, um es erneut anzusehen, ohne den Agenten neu zu starten.\nconst r = $input.first().json ?? {};\nif (!r.id) return [{ json: { ok: false, erreur: 'inconnu' } }];\nreturn [\n  {\n    json: {\n      ok: true,\n      id: r.id,\n      aidant: r.aidant,\n      personne_soignee: r.personne,\n      recu_le: r.recu_le,\n      statut: r.statut,\n      revue: r.revue === true,\n      resultat: r.resultat ?? null,\n      derniere_decision: r.derniere_decision ?? null,\n    },\n  },\n];\n"
      },
      "id": "a1c3e000-9144-4000-8000-000000009144",
      "name": "Antwort",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Sitzungsprüfung – das « Bearer »-Token im Authorization-Header (43 URL-sichere Zeichen) wird gehasht (SHA-256): Nur der Hash steht in der Datenbank.\nconst entetes = $input.first().json?.headers ?? {};\nconst m = String(entetes.authorization ?? '').match(/^Bearer ([A-Za-z0-9_-]{43})$/);\nif (!m) return [{ json: { hash: '' } }];\nreturn [{ json: { hash: require('crypto').createHash('sha256').update(m[1]).digest('hex') } }];\n"
      },
      "id": "a1c3e000-0474-4000-8000-000000000474",
      "name": "Sitzung (Token)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
