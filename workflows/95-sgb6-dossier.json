    {
      "parameters": {
        "jsCode": "// Rentenbeiträge – letztes Ergebnis einer Akte: { id }.\nconst id = String($input.first().json?.body?.id ?? '');\nif (!/^[a-z0-9][a-z0-9-]{2,63}$/.test(id)) throw new Error('Ungültige Akten-ID');\nreturn [{ json: { id } }];\n"
      },
      "id": "a1c3e000-9142-4000-8000-000000009142",
      "name": "Akte prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT d.id, d.aidant, d.personne, d.statut, d.revue, to_char(d.recu_le, 'YYYY-MM-DD') AS recu_le, d.resultat, (SELECT jsonb_build_object('decision', x.decision, 'motif', x.motif, 'soignant', x.soignant, 'heure', x.heure) FROM soins.sgb6_decisions x WHERE x.dossier_id = d.id ORDER BY x.id DESC LIMIT 1) AS derniere_decision FROM soins.sgb6_dossiers d WHERE d.id = $1",
        "options": {
          "queryReplacement": "={{ [ $json.id ] }}"
        }
      },
      "id": "a1c3e000-9143-4000-8000-000000009143",
      "name": "Akte",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
