    {
      "parameters": {
        "jsCode": "// Cotisations retraite – dernier résultat d'un dossier : { id }.\nconst id = String($input.first().json?.body?.id ?? '');\nif (!/^[a-z0-9][a-z0-9-]{2,63}$/.test(id)) throw new Error('id de dossier invalide');\nreturn [{ json: { id } }];\n"
      },
      "id": "a1c3e000-9142-4000-8000-000000009142",
      "name": "Contrôler le dossier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT d.id, d.aidant, d.personne, d.statut, d.revue, to_char(d.recu_le, 'YYYY-MM-DD') AS recu_le, d.resultat, (SELECT jsonb_build_object('decision', x.decision, 'motif', x.motif, 'soignant', x.soignant, 'heure', x.heure) FROM soins.sgb6_decisions x WHERE x.dossier_id = d.id ORDER BY x.id DESC LIMIT 1) AS derniere_decision FROM soins.sgb6_dossiers d WHERE d.id = $1",
        "options": {
          "queryReplacement": "={{ [ $json.id ] }}"
        }
      },
      "id": "a1c3e000-9143-4000-8000-000000009143",
      "name": "Dossier",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "aicarepg00000001",
          "name": "AI-Care Postgres"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Cotisations retraite – le dernier résultat enregistré d'un dossier, pour le revoir sans relancer l'agent.\nconst r = $input.first().json ?? {};\nif (!r.id) return [{ json: { ok: false, erreur: 'inconnu' } }];\nreturn [\n  {\n    json: {\n      ok: true,\n      id: r.id,\n      aidant: r.aidant,\n      personne_soignee: r.personne,\n      recu_le: r.recu_le,\n      statut: r.statut,\n      revue: r.revue === true,\n      resultat: r.resultat ?? null,\n      derniere_decision: r.derniere_decision ?? null,\n    },\n  },\n];\n"
      },
      "id": "a1c3e000-9144-4000-8000-000000009144",
      "name": "Réponse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Contrôle de session – le jeton « Bearer » de l'en-tête Authorization (43 caractères URL-safe) est haché (SHA-256) : seul le haché est en base.\nconst entetes = $input.first().json?.headers ?? {};\nconst m = String(entetes.authorization ?? '').match(/^Bearer ([A-Za-z0-9_-]{43})$/);\nif (!m) return [{ json: { hash: '' } }];\nreturn [{ json: { hash: require('crypto').createHash('sha256').update(m[1]).digest('hex') } }];\n"
      },
      "id": "a1c3e000-0474-4000-8000-000000000474",
      "name": "Session (jeton)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        -380
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.identifiant, g.nom, s.jeton_hash FROM soins.sessions s JOIN soins.soignants g ON g.identifiant = s.identifiant WHERE s.jeton_hash = $1 AND s.expire_le > now() AND g.actif",
        "options": {
          "queryReplacement": "={{ [ $json.hash ] }}"
        }
      },
      "id": "a1c3e000-0475-4000-8000-000000000475",
      "name": "Session (base)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        -380
      ],
      "credentials": {
        "postgres": {
          "id": "aicarepg00000001",
          "name": "AI-Care Postgres"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Contrôle de session – résultat : un soignant identifié (session ouverte, non expirée, compte actif) ou rien.\nconst r = $input.first().json ?? {};\nif (!r.identifiant) return [{ json: { ok: false } }];\nreturn [{ json: { ok: true, soignant: { identifiant: r.identifiant, nom: r.nom }, jeton_hash: r.jeton_hash } }];\n"
      },
      "id": "a1c3e000-0476-4000-8000-000000000476",
