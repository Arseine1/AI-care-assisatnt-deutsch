    {
      "parameters": {
        "jsCode": "// Rentenbeiträge – Liste der Akten für die Oberfläche: Kennung, Pflegeperson, pflegebedürftige Person, Eingangsdatum, Status.\n// Weder der Text des Fragebogens noch das Ergebnis gehen in die Liste.\nconst lignes = $('Akten').all().map((i) => i.json).filter((r) => r.id);\n// von der Seite zugelassene Modelle und welche davon in Ollama installiert sind (Liste /api/tags; antwortet Ollama nicht: keines gilt als installiert)\nconst installes = ($input.first().json?.models ?? []).map((m) => m.name);\nconst modeles = [\"qwen2.5:7b\",\"qwen3:8b\",\"llama3.1:8b\",\"llama3.2\"].map((nom) => ({ nom, installe: installes.some((n) => n === nom || n === `${nom}:latest`) }));\nreturn [\n  {\n    json: {\n      modele: \"qwen2.5:7b\",\n      modeles, // das lokale Modell, das den Agenten steuert (Umgebungsvariable SGB6_MODELE bei der Generierung)\n      dossiers: lignes.map((r) => ({ id: r.id, aidant: r.aidant, personne_soignee: r.personne, recu_le: r.recu_le, statut: r.statut, revue: r.revue === true, traite: r.traite === true })),\n    },\n  },\n];\n"
      },
      "id": "a1c3e000-9004-4000-8000-000000009004",
      "name": "Liste",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Sitzungsprüfung – das « Bearer »-Token im Authorization-Header (43 URL-sichere Zeichen) wird gehasht (SHA-256): Nur der Hash steht in der Datenbank.\nconst entetes = $input.first().json?.headers ?? {};\nconst m = String(entetes.authorization ?? '').match(/^Bearer ([A-Za-z0-9_-]{43})$/);\nif (!m) return [{ json: { hash: '' } }];\nreturn [{ json: { hash: require('crypto').createHash('sha256').update(m[1]).digest('hex') } }];\n"
      },
      "id": "a1c3e000-0449-4000-8000-000000000449",
      "name": "Sitzung (Token)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        -380
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.identifiant, g.nom, s.jeton_hash FROM soins.sessions s JOIN soins.soignants g ON g.identifiant = s.identifiant WHERE s.jeton_hash = $1 AND s.expire_le > now() AND g.actif",
        "options": {
          "queryReplacement": "={{ [ $json.hash ] }}"
        }
      },
      "id": "a1c3e000-0450-4000-8000-000000000450",
      "name": "Sitzung (Datenbank)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        -380
      ],
