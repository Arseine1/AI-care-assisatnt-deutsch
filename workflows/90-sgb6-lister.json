    {
      "parameters": {
        "jsCode": "// Cotisations retraite – liste des dossiers pour l'interface : identifiant, aidant, personne soignée, date de réception, statut.\n// Ni le texte du questionnaire ni le résultat ne partent dans la liste.\nconst lignes = $('Dossiers').all().map((i) => i.json).filter((r) => r.id);\n// modèles permis par la page, et lesquels sont installés dans Ollama (liste /api/tags ; si Ollama ne répond pas : aucun n'est marqué installé)\nconst installes = ($input.first().json?.models ?? []).map((m) => m.name);\nconst modeles = [\"qwen2.5:7b\",\"qwen3:8b\",\"llama3.1:8b\",\"llama3.2\"].map((nom) => ({ nom, installe: installes.some((n) => n === nom || n === `${nom}:latest`) }));\nreturn [\n  {\n    json: {\n      modele: \"qwen2.5:7b\",\n      modeles, // le modèle local qui pilote l'agent (variable d'environnement SGB6_MODELE à la génération)\n      dossiers: lignes.map((r) => ({ id: r.id, aidant: r.aidant, personne_soignee: r.personne, recu_le: r.recu_le, statut: r.statut, revue: r.revue === true, traite: r.traite === true })),\n    },\n  },\n];\n"
      },
      "id": "a1c3e000-9004-4000-8000-000000009004",
      "name": "Liste",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Contrôle de session – le jeton « Bearer » de l'en-tête Authorization (43 caractères URL-safe) est haché (SHA-256) : seul le haché est en base.\nconst entetes = $input.first().json?.headers ?? {};\nconst m = String(entetes.authorization ?? '').match(/^Bearer ([A-Za-z0-9_-]{43})$/);\nif (!m) return [{ json: { hash: '' } }];\nreturn [{ json: { hash: require('crypto').createHash('sha256').update(m[1]).digest('hex') } }];\n"
      },
      "id": "a1c3e000-0449-4000-8000-000000000449",
      "name": "Session (jeton)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        -380
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.identifiant, g.nom, s.jeton_hash FROM soins.sessions s JOIN soins.soignants g ON g.identifiant = s.identifiant WHERE s.jeton_hash = $1 AND s.expire_le > now() AND g.actif",
        "options": {
          "queryReplacement": "={{ [ $json.hash ] }}"
        }
      },
      "id": "a1c3e000-0450-4000-8000-000000000450",
