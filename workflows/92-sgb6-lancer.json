    {
      "parameters": {
        "jsCode": "// Rentenbeiträge – den Agenten starten: { id, lecture_ia, pilote, modele }. Kein freier Text: eine Aktenkennung, ein Boolean und der Steuerer\n// (« modele » = von einem lokalen Modell gesteuert; « guidee » = vom Code geführte Mission, Standard).\nconst e = $input.first().json?.body ?? {};\nconst id = String(e.id ?? '');\nif (!/^[a-z0-9][a-z0-9-]{2,63}$/.test(id)) throw new Error('Ungültige Akten-ID');\nconst pilote = e.pilote === undefined ? 'guidee' : String(e.pilote);\nif (!['modele', 'guidee'].includes(pilote)) throw new Error('Ungültige Steuerung');\n// modele : das lokale Modell, das den Agenten steuert, auf der Seite gewählt. GESCHLOSSENE Liste (nie ein freier Name: Er geht in eine Anfrage an Ollama).\nconst PERMIS = [\"qwen2.5:7b\",\"qwen3:8b\",\"llama3.1:8b\",\"llama3.2\"];\nconst modele = e.modele === undefined || e.modele === '' ? \"qwen2.5:7b\" : String(e.modele);\nif (!PERMIS.includes(modele)) throw new Error(`Modell nicht zulässig: ${modele.slice(0, 40)}`);\nreturn [{ json: { id, lecture_ia: e.lecture_ia === true, pilote, modele } }];\n"
      },
      "id": "a1c3e000-9126-4000-8000-000000009126",
      "name": "Start prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, statut, (SELECT t.id FROM soins.taches t WHERE t.type = 'sgb6_agent' AND t.statut = 'en_cours' AND t.parametres->>'dossier' = $1 AND t.heartbeat > now() - interval '30 minutes' ORDER BY t.cree_le DESC LIMIT 1) AS tache_en_cours FROM soins.sgb6_dossiers WHERE id = $1",
        "options": {
          "queryReplacement": "={{ [ $json.id ] }}"
        }
      },
      "id": "a1c3e000-9127-4000-8000-000000009127",
      "name": "Akte",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "aicarepg00000001",
          "name": "AI-Care Postgres"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Rentenbeiträge – den Agenten starten: Existiert die Akte, ist sie nicht schon entschieden, läuft nicht schon eine Bearbeitung?\nconst d = $('Start prüfen').first().json;\nconst r = $input.first().json ?? {};\nconst refus = (reponse) => [{ json: { ok: false, reponse } }];\nif (!r.id) return refus({ ok: false, erreur: 'inconnu', message: 'Unbekannte Akte.' });\nif (['valide', 'refuse'].includes(r.statut)) return refus({ ok: false, erreur: 'decide', message: 'Diese Akte ist bereits entschieden: Sie kann nicht mehr bearbeitet werden.' });\nif (r.tache_en_cours) return refus({ ok: true, tache_id: r.tache_en_cours, id: r.id, deja: true, etapes: ['lire', 'extraire', 'controler', 'caisse', 'regles', 'calculer', 'declaration'] });\nreturn [{ json: { ok: true, id: r.id, lecture_ia: d.lecture_ia, pilote: d.pilote, modele: d.modele, soignant: $('Sitzung').first().json.soignant.identifiant } }];\n"
      },
      "id": "a1c3e000-9128-4000-8000-000000009128",
      "name": "Start überprüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Start möglich?",
              "leftValue": "={{ $json.ok === true && !$json.reponse }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1c3e000-9129-4000-8000-000000009129",
      "name": "Start möglich?",
