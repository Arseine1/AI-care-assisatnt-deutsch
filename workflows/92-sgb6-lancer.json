    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO soins.taches (type, parametres, total, statut) VALUES ('sgb6_agent', jsonb_build_object('dossier', $1::text, 'lecture_ia', $2::boolean, 'soignant', $3::text, 'pilote', $4::text, 'modele', $5::text), CASE WHEN $4::text = 'modele' THEN 12 ELSE 7 END, 'en_cours') RETURNING id",
        "options": {
          "queryReplacement": "={{ [ $json.id, $json.lecture_ia, $json.soignant, $json.pilote, $json.modele ] }}"
        }
      },
      "id": "a1c3e000-9130-4000-8000-000000009130",
      "name": "Créer la tâche",
