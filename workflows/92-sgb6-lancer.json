    {
      "parameters": {
        "jsCode": "// Cotisations retraite – lancer l'agent : { id, lecture_ia, pilote, modele }. Aucun texte libre : un identifiant de dossier, un booléen, et le pilote\n// (« modele » = piloté par un modèle local ; « guidee » = mission guidée par le code, défaut).\nconst e = $input.first().json?.body ?? {};\nconst id = String(e.id ?? '');\nif (!/^[a-z0-9][a-z0-9-]{2,63}$/.test(id)) throw new Error('id de dossier invalide');\nconst pilote = e.pilote === undefined ? 'guidee' : String(e.pilote);\nif (!['modele', 'guidee'].includes(pilote)) throw new Error('pilote invalide');\n// modele : le modèle local qui pilote l'agent, choisi dans la page. Liste FERMÉE (jamais un nom libre : il part dans une requête vers Ollama).\nconst PERMIS = [\"qwen2.5:7b\",\"qwen3:8b\",\"llama3.1:8b\",\"llama3.2\"];\nconst modele = e.modele === undefined || e.modele === '' ? \"qwen2.5:7b\" : String(e.modele);\nif (!PERMIS.includes(modele)) throw new Error(`modèle non permis : ${modele.slice(0, 40)}`);\nreturn [{ json: { id, lecture_ia: e.lecture_ia === true, pilote, modele } }];\n"
      },
      "id": "a1c3e000-9126-4000-8000-000000009126",
      "name": "Contrôler le lancement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, statut, (SELECT t.id FROM soins.taches t WHERE t.type = 'sgb6_agent' AND t.statut = 'en_cours' AND t.parametres->>'dossier' = $1 AND t.heartbeat > now() - interval '30 minutes' ORDER BY t.cree_le DESC LIMIT 1) AS tache_en_cours FROM soins.sgb6_dossiers WHERE id = $1",
        "options": {
          "queryReplacement": "={{ [ $json.id ] }}"
        }
      },
      "id": "a1c3e000-9127-4000-8000-000000009127",
      "name": "Dossier",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "aicarepg00000001",
          "name": "AI-Care Postgres"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Cotisations retraite – lancer l'agent : le dossier existe-t-il, n'est-il pas déjà décidé, un traitement n'est-il pas déjà en cours ?\nconst d = $('Contrôler le lancement').first().json;\nconst r = $input.first().json ?? {};\nconst refus = (reponse) => [{ json: { ok: false, reponse } }];\nif (!r.id) return refus({ ok: false, erreur: 'inconnu', message: 'Dossier inconnu.' });\nif (['valide', 'refuse'].includes(r.statut)) return refus({ ok: false, erreur: 'decide', message: 'Ce dossier est déjà décidé : il ne peut plus être traité.' });\nif (r.tache_en_cours) return refus({ ok: true, tache_id: r.tache_en_cours, id: r.id, deja: true, etapes: ['lire', 'extraire', 'controler', 'caisse', 'regles', 'calculer', 'declaration'] });\nreturn [{ json: { ok: true, id: r.id, lecture_ia: d.lecture_ia, pilote: d.pilote, modele: d.modele, soignant: $('Session').first().json.soignant.identifiant } }];\n"
      },
      "id": "a1c3e000-9128-4000-8000-000000009128",
      "name": "Vérifier le lancement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Lancement possible ?",
              "leftValue": "={{ $json.ok === true && !$json.reponse }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
