      "id": "a1c3e000-0052-4000-8000-000000000052",
      "name": "Lister les messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Connecteur « KIM » (boîte simulée par Mailpit) : ne garder que les messages qui ont une pièce jointe.\nconst liste = $input.first().json.messages ?? [];\nreturn liste.filter((m) => m.Attachments > 0).map((m) => ({ json: { id: m.ID } }));\n"
      },
      "id": "a1c3e000-0053-4000-8000-000000000053",
      "name": "Messages à lire",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        100
      ]
    },
    {
      "parameters": {
        "url": "=http://mailpit:8025/api/v1/message/{{ $json.id }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "a1c3e000-0054-4000-8000-000000000054",
      "name": "Détail du message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Connecteur « KIM » : une ligne par PDF joint (lettre de médecin).\nconst sortie = [];\nfor (const { json: m } of $input.all()) {\n  for (const pj of m.Attachments ?? []) {\n    const estPdf = /pdf/i.test(pj.ContentType ?? '') || /\\.pdf$/i.test(pj.FileName ?? '');\n    if (!estPdf) continue;\n    sortie.push({\n      json: {\n        id: m.ID,\n        partId: pj.PartID,\n        fileName: pj.FileName,\n        from: m.From?.Address,\n        expediteur: m.From?.Name || m.From?.Address,\n        subject: m.Subject,\n        date: m.Date,\n      },\n    });\n  }\n}\nreturn sortie;\n"
      },
      "id": "a1c3e000-0055-4000-8000-000000000055",
      "name": "Pièces jointes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        100
      ]
    },
    {
      "parameters": {
        "url": "=http://mailpit:8025/api/v1/message/{{ $json.id }}/part/{{ $json.partId }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "a1c3e000-0056-4000-8000-000000000056",
      "name": "Télécharger la pièce jointe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1460,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ocr:8000/texte",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/pdf"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {
          "timeout": 300000
        }
      },
      "id": "a1c3e000-0057-4000-8000-000000000057",
      "name": "Texte du PDF (OCRmyPDF)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1700,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Connecteur « KIM » : lettre de médecin (texte du PDF ou OCR) -> document de la collection « a_verifier ».\n//\n// Une lettre est TOUJOURS déposée dans « a_verifier » : tant qu'elle n'a pas été contrôlée (contradiction avec\n// l'allergie, le traitement, la fonction rénale…), son contenu n'est pas présenté comme fiable.\n// Rattachement au résident : le nom ET la date de naissance (jj.mm.aaaa) du courrier doivent correspondre à UN\n// seul résident (les deux « Heinz Müller » ne se distinguent que par la date). Sinon on ne devine pas :\n// la lettre reste sans patient_id, avec le motif identite_inconnue ou identite_ambigue.\nconst residents = $('Résidents').all().map((i) => i.json);\nconst pieces = $('Pièces jointes').all();\nconst norm = (s) => String(s).normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();\n\nconst docs = [];\n$input.all().forEach((item, i) => {\n  const p = pieces[i].json;\n  const texte = String(item.json.texte ?? '').trim();\n  if (!texte) return;\n\n  const t = norm(texte);\n  const trouves = residents.filter((r) => t.includes(norm(r.nom)) && texte.includes(r.naissance));\n  const base = {\n    collection: 'a_verifier',\n    source: 'kim',\n    source_label: 'KIM (lettre de médecin)',\n    // Référence stable (expéditeur + nom du fichier) : renvoyer le même courrier ne crée pas de doublon.\n    source_ref: `kim/${p.from}/${p.fileName}`,\n    type: 'lettre',\n    titre: p.subject,\n    expediteur: p.expediteur,\n    statut: 'a_verifier',\n    texte,\n    date: new Date(p.date).toISOString(),\n  };\n\n  if (trouves.length === 1) {\n    const r = trouves[0];\n    docs.push({\n      ...base,\n      motif: 'lettre_a_verifier',\n      patient_id: r.patient_id,\n      chambre: r.chambre,\n      patient_label: `${r.civilite} ${r.prenom} ${r.nom} (chambre ${r.chambre})`,\n    });\n  } else {\n    docs.push({ ...base, motif: trouves.length === 0 ? 'identite_inconnue' : 'identite_ambigue' });\n  }\n});\nreturn docs.map((json) => ({ json }));\n"
      },
      "id": "a1c3e000-0058-4000-8000-000000000058",
      "name": "Documents KIM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1940,
