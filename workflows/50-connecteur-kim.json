      "id": "a1c3e000-0059-4000-8000-000000000059",
      "name": "Indizieren",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2180,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Sitzungsprüfung – das « Bearer »-Token im Authorization-Header (43 URL-sichere Zeichen) wird gehasht (SHA-256): Nur der Hash steht in der Datenbank.\nconst entetes = $input.first().json?.headers ?? {};\nconst m = String(entetes.authorization ?? '').match(/^Bearer ([A-Za-z0-9_-]{43})$/);\nif (!m) return [{ json: { hash: '' } }];\nreturn [{ json: { hash: require('crypto').createHash('sha256').update(m[1]).digest('hex') } }];\n"
      },
      "id": "a1c3e000-0357-4000-8000-000000000357",
      "name": "Sitzung (Token)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        -180
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.identifiant, g.nom, s.jeton_hash FROM soins.sessions s JOIN soins.soignants g ON g.identifiant = s.identifiant WHERE s.jeton_hash = $1 AND s.expire_le > now() AND g.actif",
        "options": {
          "queryReplacement": "={{ [ $json.hash ] }}"
        }
      },
      "id": "a1c3e000-0358-4000-8000-000000000358",
      "name": "Sitzung (Datenbank)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        -180
      ],
      "credentials": {
        "postgres": {
          "id": "aicarepg00000001",
          "name": "AI-Care Postgres"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Sitzungsprüfung – Ergebnis: eine identifizierte Pflegekraft (Sitzung offen, nicht abgelaufen, Konto aktiv) oder nichts.\nconst r = $input.first().json ?? {};\nif (!r.identifiant) return [{ json: { ok: false } }];\nreturn [{ json: { ok: true, soignant: { identifiant: r.identifiant, nom: r.nom }, jeton_hash: r.jeton_hash } }];\n"
      },
      "id": "a1c3e000-0359-4000-8000-000000000359",
      "name": "Sitzung",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
