        500,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// KIM-Konnektor (von Mailpit simuliertes Postfach): nur Nachrichten mit Anhang behalten.\nconst liste = $input.first().json.messages ?? [];\nreturn liste.filter((m) => m.Attachments > 0).map((m) => ({ json: { id: m.ID } }));\n"
      },
      "id": "a1c3e000-0053-4000-8000-000000000053",
      "name": "Zu lesende Nachrichten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        100
      ]
    },
    {
      "parameters": {
        "url": "=http://mailpit:8025/api/v1/message/{{ $json.id }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "a1c3e000-0054-4000-8000-000000000054",
      "name": "Nachrichtendetail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// KIM-Konnektor: eine Zeile je angehängtem PDF (Arztbrief).\nconst sortie = [];\nfor (const { json: m } of $input.all()) {\n  for (const pj of m.Attachments ?? []) {\n    const estPdf = /pdf/i.test(pj.ContentType ?? '') || /\\.pdf$/i.test(pj.FileName ?? '');\n    if (!estPdf) continue;\n    sortie.push({\n      json: {\n        id: m.ID,\n        partId: pj.PartID,\n        fileName: pj.FileName,\n        from: m.From?.Address,\n        expediteur: m.From?.Name || m.From?.Address,\n        subject: m.Subject,\n        date: m.Date,\n      },\n    });\n  }\n}\nreturn sortie;\n"
      },
      "id": "a1c3e000-0055-4000-8000-000000000055",
      "name": "Anhänge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        100
      ]
    },
    {
      "parameters": {
        "url": "=http://mailpit:8025/api/v1/message/{{ $json.id }}/part/{{ $json.partId }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "a1c3e000-0056-4000-8000-000000000056",
      "name": "Anhang herunterladen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1460,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ocr:8000/texte",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/pdf"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {
          "timeout": 300000
        }
      },
      "id": "a1c3e000-0057-4000-8000-000000000057",
      "name": "PDF-Text (OCRmyPDF)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1700,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// KIM-Konnektor: Arztbrief (PDF-Text oder OCR) -> Dokument der Collection « a_verifier ».\n//\n// Ein Arztbrief wird IMMER in « a_verifier » abgelegt: Solange er nicht geprüft wurde (Widerspruch zu\n// Allergie, Behandlung, Nierenfunktion …), wird sein Inhalt nicht als verlässlich dargestellt.\n// Zuordnung zum Bewohner: Name UND Geburtsdatum (TT.MM.JJJJ) des Schreibens müssen zu GENAU EINEM\n// Bewohner passen (die beiden „Heinz Müller“ unterscheiden sich nur durch das Datum). Sonst wird nicht geraten:\n// Der Brief bleibt ohne patient_id, mit dem Motiv identite_inconnue oder identite_ambigue.\nconst residents = $('Bewohnerliste').all().map((i) => i.json);\nconst pieces = $('Anhänge').all();\nconst norm = (s) => String(s).normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();\n\nconst docs = [];\n$input.all().forEach((item, i) => {\n  const p = pieces[i].json;\n  const texte = String(item.json.texte ?? '').trim();\n  if (!texte) return;\n\n  const t = norm(texte);\n  const trouves = residents.filter((r) => t.includes(norm(r.nom)) && texte.includes(r.naissance));\n  const base = {\n    collection: 'a_verifier',\n    source: 'kim',\n    source_label: 'KIM (Arztbrief)',\n    // Stabile Referenz (Absender + Dateiname): Das erneute Senden desselben Schreibens erzeugt kein Duplikat.\n    source_ref: `kim/${p.from}/${p.fileName}`,\n    type: 'lettre',\n    titre: p.subject,\n    expediteur: p.expediteur,\n    statut: 'a_verifier',\n    texte,\n    date: new Date(p.date).toISOString(),\n  };\n\n  if (trouves.length === 1) {\n    const r = trouves[0];\n    docs.push({\n      ...base,\n      motif: 'lettre_a_verifier',\n      patient_id: r.patient_id,\n      chambre: r.chambre,\n      patient_label: `${r.civilite} ${r.prenom} ${r.nom} (Zimmer ${r.chambre})`,\n    });\n  } else {\n    docs.push({ ...base, motif: trouves.length === 0 ? 'identite_inconnue' : 'identite_ambigue' });\n  }\n});\nreturn docs.map((json) => ({ json }));\n"
      },
      "id": "a1c3e000-0058-4000-8000-000000000058",
      "name": "KIM-Dokumente",
