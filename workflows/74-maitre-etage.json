      "parameters": {
        "jsCode": "// Rapport de garde d'un étage – ce qui part vers le sous-workflow « étage complet » : l'étage et la tâche déjà créée.\nconst etage = $('Contrôler l\\'étage').first().json.etage;\nconst task_id = $('Créer la tâche').first().json.id;\nreturn [{ json: { etage, task_id } }];\n"
      },
      "id": "a1c3e000-0185-4000-8000-000000000185",
