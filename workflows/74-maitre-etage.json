    {
      "parameters": {
        "jsCode": "// Contrôle de session – le jeton « Bearer » de l'en-tête Authorization (43 caractères URL-safe) est haché (SHA-256) : seul le haché est en base.\nconst entetes = $input.first().json?.headers ?? {};\nconst m = String(entetes.authorization ?? '').match(/^Bearer ([A-Za-z0-9_-]{43})$/);\nif (!m) return [{ json: { hash: '' } }];\nreturn [{ json: { hash: require('crypto').createHash('sha256').update(m[1]).digest('hex') } }];\n"
      },
      "id": "a1c3e000-0399-4000-8000-000000000399",
      "name": "Session (jeton)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        -380
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.identifiant, g.nom, s.jeton_hash FROM soins.sessions s JOIN soins.soignants g ON g.identifiant = s.identifiant WHERE s.jeton_hash = $1 AND s.expire_le > now() AND g.actif",
        "options": {
          "queryReplacement": "={{ [ $json.hash ] }}"
        }
      },
