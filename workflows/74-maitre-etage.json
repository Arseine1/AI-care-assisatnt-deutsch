    {
      "parameters": {
        "jsCode": "// Dienstbericht einer Etage – Prüfung der Anfrage {etage}. Kein Freitext: nur eine Etagennummer.\nconst e = $input.first().json?.body ?? {};\nconst etage = Number(e.etage);\nif (!Number.isInteger(etage) || etage < 0 || etage > 20) throw new Error(`Ungültige Etage: „${e.etage}“`);\nreturn [{ json: { etage } }];\n"
      },
      "id": "a1c3e000-0181-4000-8000-000000000181",
      "name": "Etage prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT patient_id FROM soins.residents WHERE etage = $1 ORDER BY chambre",
        "options": {
          "queryReplacement": "={{ [ $json.etage ] }}"
        }
      },
      "id": "a1c3e000-0182-4000-8000-000000000182",
      "name": "Bewohner der Etage",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "aicarepg00000001",
          "name": "AI-Care Postgres"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO soins.taches (type, parametres, total, statut, termine_le) VALUES ('rapport_garde_etage', jsonb_build_object('etage', $1::int), $2::int, CASE WHEN $2::int = 0 THEN 'termine' ELSE 'en_cours' END, CASE WHEN $2::int = 0 THEN now() END) RETURNING id",
        "options": {
          "queryReplacement": "={{ [ $('Etage prüfen').first().json.etage, $('Bewohner der Etage').all().filter(i => i.json.patient_id).length ] }}"
        }
      },
      "id": "a1c3e000-0183-4000-8000-000000000183",
      "name": "Aufgabe erstellen",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
