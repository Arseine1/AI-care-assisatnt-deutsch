    {
      "parameters": {
        "jsCode": "// Dienstbericht einer Etage – was an den Unter-Workflow « Etage komplett » geht: die Etage und die bereits erstellte Aufgabe.\nconst etage = $('Etage prüfen').first().json.etage;\nconst task_id = $('Aufgabe erstellen').first().json.id;\nreturn [{ json: { etage, task_id } }];\n"
      },
      "id": "a1c3e000-0185-4000-8000-000000000185",
      "name": "Zum vollständigen Etagenbericht",
