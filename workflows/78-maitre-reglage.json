    {
      "parameters": {
        "jsCode": "// Einstellung der zusätzlichen Analyse durch die KI (« Dokument prüfen »): { valeur: true|false } zum Schreiben,\n// { } zum Lesen. Es gibt nur einen Schlüssel; über dieses Tor kann kein anderer angelegt werden.\nconst e = $input.first().json?.body ?? {};\nconst cle = 'verification_ia';\nlet valeur = '';\nif (e.valeur !== undefined) {\n  if (typeof e.valeur !== 'boolean') throw new Error('valeur: true oder false erwartet');\n  valeur = String(e.valeur);\n}\nreturn [{ json: { cle, valeur } }];\n"
      },
      "id": "a1c3e000-0239-4000-8000-000000000239",
      "name": "Einstellung prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH w AS (INSERT INTO soins.reglages (cle, valeur) SELECT $1, to_jsonb(NULLIF($2, '')::boolean) WHERE $2 <> '' ON CONFLICT (cle) DO UPDATE SET valeur = excluded.valeur, modifie_le = now() RETURNING valeur) SELECT coalesce((SELECT valeur FROM w), (SELECT valeur FROM soins.reglages WHERE cle = $1), 'true'::jsonb) AS valeur",
        "options": {
          "queryReplacement": "={{ [ $json.cle, $json.valeur ] }}"
        }
      },
      "id": "a1c3e000-0240-4000-8000-000000000240",
      "name": "Lesen oder Schreiben",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "aicarepg00000001",
          "name": "AI-Care Postgres"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Einstellung der zusätzlichen Analyse – Antwort an die Oberfläche.\nconst r = $input.first().json ?? {};\nreturn [{ json: { cle: 'verification_ia', valeur: r.valeur !== false } }];\n"
      },
      "id": "a1c3e000-0241-4000-8000-000000000241",
      "name": "Antwort",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Sitzungsprüfung – das « Bearer »-Token im Authorization-Header (43 URL-sichere Zeichen) wird gehasht (SHA-256): Nur der Hash steht in der Datenbank.\nconst entetes = $input.first().json?.headers ?? {};\nconst m = String(entetes.authorization ?? '').match(/^Bearer ([A-Za-z0-9_-]{43})$/);\nif (!m) return [{ json: { hash: '' } }];\nreturn [{ json: { hash: require('crypto').createHash('sha256').update(m[1]).digest('hex') } }];\n"
      },
      "id": "a1c3e000-0425-4000-8000-000000000425",
      "name": "Sitzung (Token)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        -380
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.identifiant, g.nom, s.jeton_hash FROM soins.sessions s JOIN soins.soignants g ON g.identifiant = s.identifiant WHERE s.jeton_hash = $1 AND s.expire_le > now() AND g.actif",
        "options": {
          "queryReplacement": "={{ [ $json.hash ] }}"
        }
      },
      "id": "a1c3e000-0426-4000-8000-000000000426",
