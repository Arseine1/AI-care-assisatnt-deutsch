{
  "id": "aicaremaitreregl01",
  "name": "AI-Care – Réglage de l'analyse complémentaire par l'IA",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aicare-reglage",
        "responseMode": "lastNode",
        "options": {
          "allowedOrigins": "http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175"
        },
        "authentication": "headerAuth"
      },
      "id": "a1c3e000-0238-4000-8000-000000000238",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "aicare-aicare-reglage",
      "credentials": {
        "httpHeaderAuth": {
          "id": "aicarecle000000001",
          "name": "AI-Care clé des webhooks"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Réglage de l'analyse complémentaire par l'IA (« Vérifier le document ») : { valeur: true|false } pour l'écrire,\n// { } pour la lire. Une seule clé existe, aucune autre ne peut être créée par cette porte.\nconst e = $input.first().json?.body ?? {};\nconst cle = 'verification_ia';\nlet valeur = '';\nif (e.valeur !== undefined) {\n  if (typeof e.valeur !== 'boolean') throw new Error('valeur : true ou false attendu');\n  valeur = String(e.valeur);\n}\nreturn [{ json: { cle, valeur } }];\n"
      },
      "id": "a1c3e000-0239-4000-8000-000000000239",
      "name": "Contrôler le réglage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH w AS (INSERT INTO soins.reglages (cle, valeur) SELECT $1, to_jsonb(NULLIF($2, '')::boolean) WHERE $2 <> '' ON CONFLICT (cle) DO UPDATE SET valeur = excluded.valeur, modifie_le = now() RETURNING valeur) SELECT coalesce((SELECT valeur FROM w), (SELECT valeur FROM soins.reglages WHERE cle = $1), 'true'::jsonb) AS valeur",
        "options": {
          "queryReplacement": "={{ [ $json.cle, $json.valeur ] }}"
        }
      },
      "id": "a1c3e000-0240-4000-8000-000000000240",
      "name": "Lire ou écrire",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "aicarepg00000001",
          "name": "AI-Care Postgres"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Réglage de l'analyse complémentaire – réponse à l'interface.\nconst r = $input.first().json ?? {};\nreturn [{ json: { cle: 'verification_ia', valeur: r.valeur !== false } }];\n"
      },
      "id": "a1c3e000-0241-4000-8000-000000000241",
      "name": "Réponse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Contrôle de session – le jeton « Bearer » de l'en-tête Authorization (43 caractères URL-safe) est haché (SHA-256) : seul le haché est en base.\nconst entetes = $input.first().json?.headers ?? {};\nconst m = String(entetes.authorization ?? '').match(/^Bearer ([A-Za-z0-9_-]{43})$/);\nif (!m) return [{ json: { hash: '' } }];\nreturn [{ json: { hash: require('crypto').createHash('sha256').update(m[1]).digest('hex') } }];\n"
      },
      "id": "a1c3e000-0425-4000-8000-000000000425",
      "name": "Session (jeton)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        -380
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.identifiant, g.nom, s.jeton_hash FROM soins.sessions s JOIN soins.soignants g ON g.identifiant = s.identifiant WHERE s.jeton_hash = $1 AND s.expire_le > now() AND g.actif",
        "options": {
          "queryReplacement": "={{ [ $json.hash ] }}"
        }
      },
      "id": "a1c3e000-0426-4000-8000-000000000426",
      "name": "Session (base)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        -380
      ],
      "credentials": {
        "postgres": {
          "id": "aicarepg00000001",
          "name": "AI-Care Postgres"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Contrôle de session – résultat : un soignant identifié (session ouverte, non expirée, compte actif) ou rien.\nconst r = $input.first().json ?? {};\nif (!r.identifiant) return [{ json: { ok: false } }];\nreturn [{ json: { ok: true, soignant: { identifiant: r.identifiant, nom: r.nom }, jeton_hash: r.jeton_hash } }];\n"
      },
      "id": "a1c3e000-0427-4000-8000-000000000427",
      "name": "Session",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
