{
  "id": "aicaremaitreaut01",
  "name": "AI-Care – Rapports d'étage automatiques (5h30)",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 30 5 * * *"
            }
          ]
        }
      },
      "id": "a1c3e000-0191-4000-8000-000000000191",
      "name": "Planification 5h30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        -200
      ]
    },
    {
      "parameters": {},
      "id": "a1c3e000-0192-4000-8000-000000000192",
      "name": "Démarrage manuel",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "etage-auto",
        "responseMode": "onReceived",
        "options": {
          "allowedOrigins": "http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175"
        },
        "authentication": "headerAuth"
      },
      "id": "a1c3e000-0193-4000-8000-000000000193",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "aicare-etage-auto",
      "credentials": {
        "httpHeaderAuth": {
          "id": "aicarecle000000001",
          "name": "AI-Care clé des webhooks"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO soins.taches (type, parametres, total) SELECT 'rapport_garde_etage', jsonb_build_object('etage', r.etage, 'automatique', true), count(*) FROM soins.residents r GROUP BY r.etage HAVING NOT EXISTS (SELECT 1 FROM soins.taches t WHERE t.type = 'rapport_garde_etage' AND t.parametres->>'automatique' = 'true' AND t.parametres->>'etage' = r.etage::text AND t.cree_le > now() - interval '3 hours') RETURNING id, (parametres->>'etage')::int AS etage",
        "options": {
          "queryReplacement": "={{ [  ] }}"
        }
      },
      "id": "a1c3e000-0194-4000-8000-000000000194",
      "name": "Créer les tâches",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        260,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "aicarepg00000001",
          "name": "AI-Care Postgres"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Rapport d'étage automatique (5h30) – un élément par étage dont la tâche vient d'être créée.\n// Aucun étage n'est créé deux fois en 3 heures (relance de n8n, déclenchement manuel) : la requête les écarte déjà.\nreturn $input.all().map((i) => i.json).filter((r) => r.id).map((r) => ({ json: { etage: Number(r.etage), task_id: r.id } }));\n"
      },
      "id": "a1c3e000-0195-4000-8000-000000000195",
      "name": "Étages à traiter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "aicarebrqetagecp1",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "a1c3e000-0196-4000-8000-000000000196",
      "name": "Étage complet",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        740,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Contrôle de session – le jeton « Bearer » de l'en-tête Authorization (43 caractères URL-safe) est haché (SHA-256) : seul le haché est en base.\nconst entetes = $input.first().json?.headers ?? {};\nconst m = String(entetes.authorization ?? '').match(/^Bearer ([A-Za-z0-9_-]{43})$/);\nif (!m) return [{ json: { hash: '' } }];\nreturn [{ json: { hash: require('crypto').createHash('sha256').update(m[1]).digest('hex') } }];\n"
      },
      "id": "a1c3e000-0412-4000-8000-000000000412",
      "name": "Session (jeton)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        -180
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.identifiant, g.nom, s.jeton_hash FROM soins.sessions s JOIN soins.soignants g ON g.identifiant = s.identifiant WHERE s.jeton_hash = $1 AND s.expire_le > now() AND g.actif",
        "options": {
          "queryReplacement": "={{ [ $json.hash ] }}"
        }
      },
      "id": "a1c3e000-0413-4000-8000-000000000413",
      "name": "Session (base)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        -180
      ],
      "credentials": {
        "postgres": {
          "id": "aicarepg00000001",
          "name": "AI-Care Postgres"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Contrôle de session – résultat : un soignant identifié (session ouverte, non expirée, compte actif) ou rien.\nconst r = $input.first().json ?? {};\nif (!r.identifiant) return [{ json: { ok: false } }];\nreturn [{ json: { ok: true, soignant: { identifiant: r.identifiant, nom: r.nom }, jeton_hash: r.jeton_hash } }];\n"
      },
      "id": "a1c3e000-0414-4000-8000-000000000414",
      "name": "Session",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        -180
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Session valide ?",
              "leftValue": "={{ $json.ok === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1c3e000-0415-4000-8000-000000000415",
      "name": "Session valide ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        -180
      ]
    },
    {
      "parameters": {
        "jsCode": "// Contrôle de session – la session est valide : on rend aux nœuds suivants la requête d'origine (en-têtes, corps) telle que reçue.\nreturn [{ json: $('Webhook').first().json }];\n"
      },
      "id": "a1c3e000-0416-4000-8000-000000000416",
      "name": "Requête",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        -260
      ]
    },
    {
      "parameters": {
        "jsCode": "// Contrôle de session – refus : aucune donnée, seulement le motif. L'interface rouvre alors la page de connexion.\nreturn [{ json: { erreur: 'session' } }];\n"
      },
      "id": "a1c3e000-0417-4000-8000-000000000417",
      "name": "Refus (session)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
