      "webhookId": "aicare-etage-auto",
      "credentials": {
        "httpHeaderAuth": {
          "id": "aicarecle000000001",
          "name": "AI-Care clé des webhooks"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO soins.taches (type, parametres, total) SELECT 'rapport_garde_etage', jsonb_build_object('etage', r.etage, 'automatique', true), count(*) FROM soins.residents r GROUP BY r.etage HAVING NOT EXISTS (SELECT 1 FROM soins.taches t WHERE t.type = 'rapport_garde_etage' AND t.parametres->>'automatique' = 'true' AND t.parametres->>'etage' = r.etage::text AND t.cree_le > now() - interval '3 hours') RETURNING id, (parametres->>'etage')::int AS etage",
        "options": {
          "queryReplacement": "={{ [  ] }}"
        }
      },
      "id": "a1c3e000-0194-4000-8000-000000000194",
      "name": "Aufgaben erstellen",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        260,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "aicarepg00000001",
          "name": "AI-Care Postgres"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Automatischer Etagenbericht (5:30 Uhr) – ein Element je Etage, deren Aufgabe soeben erstellt wurde.\n// Keine Etage wird innerhalb von 3 Stunden zweimal angelegt (Neustart von n8n, manuelle Auslösung): Die Abfrage schließt sie bereits aus.\nreturn $input.all().map((i) => i.json).filter((r) => r.id).map((r) => ({ json: { etage: Number(r.etage), task_id: r.id } }));\n"
      },
      "id": "a1c3e000-0195-4000-8000-000000000195",
      "name": "Zu bearbeitende Etagen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "aicarebrqetagecp1",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "a1c3e000-0196-4000-8000-000000000196",
      "name": "Vollständiger Etagenbericht",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        740,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Sitzungsprüfung – das « Bearer »-Token im Authorization-Header (43 URL-sichere Zeichen) wird gehasht (SHA-256): Nur der Hash steht in der Datenbank.\nconst entetes = $input.first().json?.headers ?? {};\nconst m = String(entetes.authorization ?? '').match(/^Bearer ([A-Za-z0-9_-]{43})$/);\nif (!m) return [{ json: { hash: '' } }];\nreturn [{ json: { hash: require('crypto').createHash('sha256').update(m[1]).digest('hex') } }];\n"
      },
      "id": "a1c3e000-0412-4000-8000-000000000412",
      "name": "Sitzung (Token)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        -180
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.identifiant, g.nom, s.jeton_hash FROM soins.sessions s JOIN soins.soignants g ON g.identifiant = s.identifiant WHERE s.jeton_hash = $1 AND s.expire_le > now() AND g.actif",
        "options": {
          "queryReplacement": "={{ [ $json.hash ] }}"
        }
      },
      "id": "a1c3e000-0413-4000-8000-000000000413",
      "name": "Sitzung (Datenbank)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        -180
      ],
      "credentials": {
        "postgres": {
          "id": "aicarepg00000001",
          "name": "AI-Care Postgres"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Sitzungsprüfung – Ergebnis: eine identifizierte Pflegekraft (Sitzung offen, nicht abgelaufen, Konto aktiv) oder nichts.\nconst r = $input.first().json ?? {};\nif (!r.identifiant) return [{ json: { ok: false } }];\nreturn [{ json: { ok: true, soignant: { identifiant: r.identifiant, nom: r.nom }, jeton_hash: r.jeton_hash } }];\n"
      },
      "id": "a1c3e000-0414-4000-8000-000000000414",
      "name": "Sitzung",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
