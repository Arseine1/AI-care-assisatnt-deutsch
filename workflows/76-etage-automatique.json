          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Sitzung gültig?",
              "leftValue": "={{ $json.ok === true }}",
