      "id": "a1c3e000-0033-4000-8000-000000000033",
      "name": "OCR (OCRmyPDF)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Connecteur « fichiers » – branche PDF : le service OCR renvoie {texte, methode} ; on rattache le nom du fichier.\n// (Le texte natif des PDF est lu par pdftotext, seuls les PDF « image » passent par OCRmyPDF.)\nconst fichiers = $('Est un PDF').all(0);\nreturn $input.all().map((item, i) => ({\n  json: { nom: fichiers[i].binary.data.fileName, texte: item.json.texte ?? '', methode: item.json.methode ?? 'ocr' },\n}));\n"
      },
      "id": "a1c3e000-0034-4000-8000-000000000034",
      "name": "Nom du fichier PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Connecteur « fichiers » – branche texte (.md, .txt) : décoder le contenu du fichier lu sur disque.\nconst sortie = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const octets = await this.helpers.getBinaryDataBuffer(i, 'data');\n  sortie.push({ json: { nom: items[i].binary.data.fileName, texte: octets.toString('utf8'), methode: 'texte' } });\n}\nreturn sortie;\n"
      },
      "id": "a1c3e000-0035-4000-8000-000000000035",
      "name": "Décoder le texte",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        220
      ]
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "a1c3e000-0036-4000-8000-000000000036",
      "name": "Réunir",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1460,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Connecteur « fichiers » : un fichier = un document.\n//  - protocole-*.md          -> collection « connaissances » (règles générales, sans patient)\n//  - autre document (scan)   -> rattaché à UN résident si le nom ET la date de naissance du texte correspondent\n//                               (les homonymes ne se distinguent que par la date de naissance) ;\n//                               sinon collection « a_verifier » : on ne devine jamais l'identité.\nconst residents = $('Résidents').all().map((i) => i.json);\nconst norm = (s) => String(s).normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();\n\nconst docs = [];\nfor (const { json: f } of $input.all()) {\n  const nom = f.nom;\n  const texte = (f.texte ?? '').trim();\n  if (!texte) continue;\n\n  const base = {\n    source: 'fichier',\n    source_label: 'Fichiers',\n    source_ref: `fichiers/${nom}`,\n    titre: nom.replace(/\\.[a-z]+$/i, '').replace(/[-_]/g, ' '),\n  };\n\n  if (/^protocole-/i.test(nom)) {\n    docs.push({\n      ...base,\n      collection: 'connaissances',\n      type: 'protocole',\n      theme: nom.replace(/^protocole-/i, '').replace(/\\.[a-z]+$/i, ''),\n      texte,\n    });\n    continue;\n  }\n\n  // Document propre à un résident : identification par nom + date de naissance (jj.mm.aaaa).\n  const t = norm(texte);\n  const trouves = residents.filter((r) => t.includes(norm(r.nom)) && texte.includes(r.naissance));\n  const m = texte.match(/(\\d{2})[./](\\d{2})[./](20\\d{2})/); // « Date : jj/mm/aaaa » du document\n  const date = m ? new Date(Date.UTC(+m[3], +m[2] - 1, +m[1], 12)).toISOString() : new Date().toISOString();\n\n  if (trouves.length === 1) {\n    const r = trouves[0];\n    docs.push({\n      ...base,\n      collection: 'patients',\n      type: 'document',\n      texte,\n      patient_id: r.patient_id,\n      chambre: r.chambre,\n      patient_label: `${r.civilite} ${r.prenom} ${r.nom} (chambre ${r.chambre})`,\n      date,\n    });\n  } else {\n    docs.push({\n      ...base,\n      collection: 'a_verifier',\n      type: 'document',\n      statut: 'a_verifier',\n      motif: trouves.length === 0 ? 'identite_inconnue' : 'identite_ambigue',\n      texte,\n      date,\n    });\n  }\n}\nreturn docs.map((json) => ({ json }));\n"
      },
      "id": "a1c3e000-0037-4000-8000-000000000037",
      "name": "Documents fichiers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
