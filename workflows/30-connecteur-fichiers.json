          },
          "conditions": [
            {
              "id": "Session valide ?",
              "leftValue": "={{ $json.ok === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1c3e000-0348-4000-8000-000000000348",
      "name": "Session valide ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        -180
      ]
    },
    {
      "parameters": {
        "jsCode": "// Contrôle de session – la session est valide : on rend aux nœuds suivants la requête d'origine (en-têtes, corps) telle que reçue.\nreturn [{ json: $('Webhook').first().json }];\n"
      },
      "id": "a1c3e000-0349-4000-8000-000000000349",
      "name": "Requête",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        -260
      ]
    },
    {
      "parameters": {
        "jsCode": "// Contrôle de session – refus : aucune donnée, seulement le motif. L'interface rouvre alors la page de connexion.\nreturn [{ json: { erreur: 'session' } }];\n"
      },
      "id": "a1c3e000-0350-4000-8000-000000000350",
      "name": "Refus (session)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        -100
      ]
    }
