# Copier ce fichier en .env puis remplacer les valeurs TA-CLE.
# Ne jamais committer le fichier .env.

# PostgreSQL
POSTGRES_USER=TA-CLE
POSTGRES_PASSWORD=TA-CLE
POSTGRES_DB=TA-CLE

# n8n (même base que PostgreSQL ci-dessus)
DB_POSTGRESDB_USER=TA-CLE
DB_POSTGRESDB_PASSWORD=TA-CLE
DB_POSTGRESDB_DATABASE=TA-CLE
N8N_ENCRYPTION_KEY=TA-CLE

# Adresses internes (par nom de service)
OLLAMA_URL=http://host.docker.internal:11434
QDRANT_URL=http://qdrant:6333
FHIR_URL=http://hapi-fhir:8080/fhir
MQTT_URL=mqtt://mosquitto:1883
MAILPIT_SMTP=mailpit:1025

# Front
# true = réponses simulées (aucun service nécessaire) ; false = webhooks n8n réels (Docker, n8n et Ollama démarrés)
VITE_MOCK=true
VITE_N8N_WEBHOOK_URL=http://localhost:5679/webhook

# Sécurité (étape 7) : `node scripts/generer-secrets.mjs` crée ces valeurs au hasard dans .env
# Clé secrète envoyée par l'interface à chaque webhook n8n (la même valeur aux deux endroits)
AICARE_CLE_WEBHOOK=TA-CLE
VITE_N8N_CLE=TA-CLE
# Comptes du broker MQTT : n8n lit les alarmes, les capteurs (et le script de simulation) publient
MQTT_UTILISATEUR_N8N=n8n
MQTT_MOT_DE_PASSE_N8N=TA-CLE
MQTT_UTILISATEUR_CAPTEURS=capteurs
MQTT_MOT_DE_PASSE_CAPTEURS=TA-CLE

# Pont TTN (The Things Network) : alarmes de capteurs reçues depuis votre compte TTN. Laisser vide pour désactiver.
TTN_SERVEUR=eu1.cloud.thethings.network
TTN_PORT=8883
TTN_APPLICATION=TON-IDENTIFIANT-D-APPLICATION
TTN_CLE_API=TA-CLE

# Sécurité de l'interface (jour 4, étape 7) : clé interne de n8n et PIN des comptes de démonstration. Générés par : node scripts/generer-secrets.mjs
AICARE_CLE_INTERNE=TA-CLE
DEMO_PIN_MARTIN=TA-CLE
DEMO_PIN_KELLER=TA-CLE
DEMO_PIN_ROTH=TA-CLE
DEMO_PIN_ARSENE=TA-CLE
