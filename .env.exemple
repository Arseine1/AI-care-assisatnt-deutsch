# Muss nicht von Hand kopiert oder ausgefüllt werden: `node scripts/installer.mjs` erstellt .env (aus .env.prototype) und ersetzt jedes TA-CLE durch einen Zufallswert.
# Die Datei .env niemals committen.

# PostgreSQL
POSTGRES_USER=TA-CLE
POSTGRES_PASSWORD=TA-CLE
POSTGRES_DB=TA-CLE

# n8n (dieselbe Datenbank wie PostgreSQL oben)
DB_POSTGRESDB_USER=TA-CLE
DB_POSTGRESDB_PASSWORD=TA-CLE
DB_POSTGRESDB_DATABASE=TA-CLE
N8N_ENCRYPTION_KEY=TA-CLE

# Interne Adressen (über den Dienstnamen)
OLLAMA_URL=http://host.docker.internal:11434
QDRANT_URL=http://qdrant:6333
FHIR_URL=http://hapi-fhir:8080/fhir
MQTT_URL=mqtt://mosquitto:1883
MAILPIT_SMTP=mailpit:1025

# Front
# true = simulierte Antworten (kein Dienst nötig); false = echte n8n-Webhooks (Docker, n8n und Ollama gestartet)
VITE_MOCK=true
VITE_N8N_WEBHOOK_URL=http://localhost:5679/webhook

# Sicherheit (Schritt 7): `node scripts/generer-secrets.mjs` erzeugt diese Werte zufällig in der .env
# Geheimer Schlüssel, den die Oberfläche bei jedem n8n-Webhook mitsendet (derselbe Wert an beiden Stellen)
AICARE_CLE_WEBHOOK=TA-CLE
VITE_N8N_CLE=TA-CLE
# Konten des MQTT-Brokers: n8n liest die Alarme, die Sensoren (und das Simulationsskript) veröffentlichen
MQTT_UTILISATEUR_N8N=n8n
MQTT_MOT_DE_PASSE_N8N=TA-CLE
MQTT_UTILISATEUR_CAPTEURS=capteurs
MQTT_MOT_DE_PASSE_CAPTEURS=TA-CLE

# TTN-Brücke (The Things Network): Sensoralarme, die von Ihrem TTN-Konto empfangen werden. Zum Deaktivieren leer lassen.
TTN_SERVEUR=eu1.cloud.thethings.network
TTN_PORT=8883
TTN_APPLICATION=TON-IDENTIFIANT-D-APPLICATION
TTN_CLE_API=TA-CLE

# Sicherheit der Oberfläche (Tag 4, Schritt 7): interner Schlüssel von n8n und PIN der Demokonten. Erzeugt mit: node scripts/generer-secrets.mjs
AICARE_CLE_INTERNE=TA-CLE
DEMO_PIN_MARTIN=TA-CLE
DEMO_PIN_KELLER=TA-CLE
DEMO_PIN_ROTH=TA-CLE
DEMO_PIN_ARSENE=TA-CLE
